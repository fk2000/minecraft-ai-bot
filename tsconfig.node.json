{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "src/bot/**/*.ts",
    "src/jev/client.ts",
    "src/jev/evaluator.ts",
    "src/jev/daily-quota.ts"
  ],
  "exclude": ["src/bot/state.ts"]
}
